# Block traffic to/from a specific IP and terminate existing connections
    $badIP = '46.161.50.108'

    # 1) Block future traffic to/from the IP
    New-NetFirewallRule -DisplayName "Block $badIP (Inbound)"  -Direction Inbound  -RemoteAddress $badIP -Action Block -Profile Any
    New-NetFirewallRule -DisplayName "Block $badIP (Outbound)" -Direction Outbound -RemoteAddress $badIP -Action Block -Profile Any

    # 2) Find and kill processes that currently have established TCP sessions with that IP
    Get-NetTCPConnection |
        Where-Object { $_.RemoteAddress -eq $badIP -and $_.State -eq 'Established' } |
        ForEach-Object {
            try {
                Stop-Process -Id $_.OwningProcess -Force -ErrorAction Stop
                Write-Host "Terminated PID $($_.OwningProcess) (local port $($_.LocalPort))"
            } catch {
                Write-Warning "Failed to terminate PID $($_.OwningProcess): $($_.Exception.Message)"
            }
        }


