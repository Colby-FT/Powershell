# LabTech Agent Installation Script
    if (-not (Test-Path -Path "HKLM:\SOFTWARE\LabTech")) {
        #Create task folder
        $taskFolder = "LabTech_Install"
        $FTDir = "$env:SystemDrive\FT"
        $workingDir = "$FTDir\$taskFolder"

        if(!(Test-Path $workingDir)){mkdir $workingDir}

        #Copy the files from the current folder to the Task Folder.
        $files = @("Agent_Install.msi","Agent_Install.mst")
        if(Test-Path "$workingDir\Agent_Install.mst"){remove-item "$workingDir\Agent_Install.mst" -Force}
        if(Test-Path "$workingDir\Agent_Install.msi"){remove-item "$workingDir\Agent_Install.msi" -Force}

        ForEach($file in $files){
            Copy-Item .\$file $workingDir\$file -Force
        }

        #Create path variables
        $mstPath = Join-Path $workingDir "Agent_Install.mst"
        $msiPath = Join-Path $workingDir "Agent_Install.msi"

        if(-not (Test-Path $msiPath)){
            Write-Error "Installer missing: $msiPath"
            exit 1
        }

        # Build argument list as separate elements (safer quoting)
        $splatArgs = @(
            '/I',
            $msiPath,
            "TRANSFORMS=`"$mstPath`"",
            '/quiet',
            '/norestart'
        )

        try {
            $installProcessVar = Start-Process -FilePath "msiexec.exe" -ArgumentList $splatArgs -Wait -PassThru -NoNewWindow
            Write-Host "Install exited with code $($installProcessVar.ExitCode)"
            if($installProcessVar.ExitCode -ne 0){
                throw "Install Process returned error code: $($installProcessVar.ExitCode)"
            }
            if(Test-Path "$workingDir\Agent_Install.mst"){remove-item "$workingDir\Agent_Install.mst" -Force}
            if(Test-Path "$workingDir\Agent_Install.msi"){remove-item "$workingDir\Agent_Install.msi" -Force}
        }
        catch {
            Write-Error "Installation failed: $_"
            if(Test-Path "$workingDir\Agent_Install.mst"){remove-item "$workingDir\Agent_Install.mst" -Force}
            if(Test-Path "$workingDir\Agent_Install.msi"){remove-item "$workingDir\Agent_Install.msi" -Force}
            exit 1
        }
    }
    Else {
        if(Test-Path "$workingDir\Agent_Install.mst"){remove-item "$workingDir\Agent_Install.mst" -Force}
        if(Test-Path "$workingDir\Agent_Install.msi"){remove-item "$workingDir\Agent_Install.msi" -Force}
        Exit 0;#Exit success.
    }


